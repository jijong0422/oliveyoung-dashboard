### 1. 왜 기존 코드에서 엉뚱한 사진이 나왔을까? (`server.ts` 개선)

기존 `server.ts`의 `/api/product-image` 엔드포인트를 보면, `BRAND_IMAGES`라는 하드코딩 객체를 먼저 조회하여 **같은 브랜드면 무조건 동일한 Unsplash 스톡 이미지로 리다이렉트**하도록 되어 있었습니다.
이를 수정하여 **1순위: 네이버 쇼핑 검색 API의 공식 고화질 대표 썸네일 → 2순위: 구글 이미지 실시간 파싱 → 3순위: 카테고리 스톡 이미지** 순으로 작동하도록 변경하면 실제 올리브영 제품 사진이 깔끔하게 로드됩니다.

```typescript
// server.ts 내 /api/product-image 라우트 교체 (하드코딩 스톡 이미지 우선 매칭 제거 & 실제 제품 사진 매칭)
app.get("/api/product-image", async (req, res) => {
  try {
    const q = String(req.query.q || "").trim();
    const category = String(req.query.category || "skincare");
    const brand = String(req.query.brand || "").trim();
    const rankNum = req.query.rank ? parseInt(String(req.query.rank), 10) : 1;

    if (!q) {
      return res.redirect(302, getProductImageUrl(category, brand, "", rankNum));
    }

    const searchKeyword = cleanSearchQuery(`${brand} ${q}`);
    const cacheKey = searchKeyword.toLowerCase();

    // 1. 로컬 이미지 캐시 확인 (Unsplash 스톡 이미지가 아닌 실제 제품 이미지가 캐싱된 경우 즉시 반환)
    if (imageCache[cacheKey] && !imageCache[cacheKey].includes("images.unsplash.com")) {
      return res.redirect(302, imageCache[cacheKey]);
    }

    // 2. 네이버 쇼핑 API가 설정되어 있다면 공식 대표 이미지 최우선 추출
    const clientId = process.env.NAVER_CLIENT_ID;
    const clientSecret = process.env.NAVER_CLIENT_SECRET;
    if (clientId && clientSecret) {
      try {
        const naverRes = await fetch(
          `https://openapi.naver.com/v1/search/shop.json?query=${encodeURIComponent(searchKeyword)}&display=1&sort=sim`,
          {
            headers: {
              "X-Naver-Client-Id": clientId,
              "X-Naver-Client-Secret": clientSecret
            }
          }
        );
        if (naverRes.ok) {
          const naverData = await naverRes.json();
          const officialImg = naverData.items?.[0]?.image;
          if (officialImg) {
            imageCache[cacheKey] = officialImg;
            saveImageCache();
            return res.redirect(302, officialImg);
          }
        }
      } catch (naverErr) {
        console.warn("Naver image lookup fallback:", naverErr);
      }
    }

    // 3. 네이버 API 미설정 시 Google 이미지에서 실제 제품 썸네일 추출
    const scrapedImg = await scrapeGoogleImage(searchKeyword);
    if (scrapedImg) {
      imageCache[cacheKey] = scrapedImg;
      saveImageCache();
      return res.redirect(302, scrapedImg);
    }

    // 4. 최후 폴백: 카테고리별 기본 이미지
    const fallbackUrl = getProductImageUrl(category, brand, q, rankNum);
    return res.redirect(302, fallbackUrl);
  } catch (err) {
    const fallbackUrl = getProductImageUrl("skincare", "", "", 1);
    return res.redirect(302, fallbackUrl);
  }
});

```

