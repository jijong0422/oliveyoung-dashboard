#### 적용 2: `src/components/ChartsBoard.tsx` (`historicalData` 기반 시계열 순위 추이 차트 & 가격대 분포 차트 완성)

기존에 Props로만 받고 쓰지 않던 `historicalData`를 활용해 **시간대별 TOP 5 제품의 순위 변동 궤적**을 그리고, 단순 평균 막대 대신 **가격 구간별(1만 원대, 2만 원대 등) 국내 vs 글로벌 SKU 분포 바 차트**를 추가한 `src/components/ChartsBoard.tsx` 전체 교체 코드입니다.

```tsx
/**
 * @license
 * SPDX-License-Identifier: Apache-2.0
 */
import React, { useState, useEffect, useMemo } from "react";
import { Search, BarChart3, Sparkles, ArrowUpRight, Layers, Activity } from "lucide-react";
import {
  ResponsiveContainer,
  LineChart,
  Line,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  Tooltip,
  CartesianGrid,
  Legend
} from "recharts";
import { Category, Product } from "../types";

interface ChartsBoardProps {
  categories: Category[];
  selectedCategory: string;
  setSelectedCategory: (cat: string) => void;
  domesticProducts: Product[];
  globalProducts: Product[];
  historicalData: { timestamp: string; products: Product[] }[];
}

function calcSafeTop10AvgPrice(products: Product[]): number {
  if (!Array.isArray(products) || products.length === 0) return 0;
  const top10 = products.slice(0, 10);
  const sum = top10.reduce((acc, p) => acc + (Number(p.price) || 0), 0);
  return Math.round(sum / top10.length);
}

const LINE_COLORS = ["#98B941", "#0284c7", "#f59e0b", "#8b5cf6", "#ec4899"];

export default function ChartsBoard({
  categories,
  selectedCategory,
  setSelectedCategory,
  domesticProducts,
  globalProducts,
  historicalData
}: ChartsBoardProps) {
  const [searchTrendData, setSearchTrendData] = useState<Array<{ period: string; ratio: number }>>([]);
  const [isLoadingTrend, setIsLoadingTrend] = useState(false);
  const [isSimulatedTrend, setIsSimulatedTrend] = useState(false);

  const [inputKeyword, setInputKeyword] = useState("수분세럼");
  const [activeKeyword, setActiveKeyword] = useState("수분세럼");

  useEffect(() => {
    const catObj = categories.find((c) => c.id === selectedCategory);
    const nextKeyword = catObj && catObj.id !== "all" ? catObj.name : "올리브영 추천";
    setInputKeyword(nextKeyword);
    setActiveKeyword(nextKeyword);
  }, [selectedCategory, categories]);

  useEffect(() => {
    if (!activeKeyword.trim()) return;
    let isMounted = true;

    const fetchDatalabTrend = async () => {
      setIsLoadingTrend(true);
      try {
        const res = await fetch("/api/naver/datalab", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ keyword: activeKeyword })
        });
        const data = await res.json();
        if (!isMounted) return;

        setIsSimulatedTrend(Boolean(data.isSimulated));
        if (Array.isArray(data.results) && Array.isArray(data.results[0]?.data)) {
          setSearchTrendData(data.results[0].data);
        } else {
          setSearchTrendData([]);
        }
      } catch (err) {
        if (isMounted) setSearchTrendData([]);
      } finally {
        if (isMounted) setIsLoadingTrend(false);
      }
    };

    fetchDatalabTrend();
    return () => {
      isMounted = false;
    };
  }, [activeKeyword]);

  const handleKeywordSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (inputKeyword.trim()) {
      setActiveKeyword(inputKeyword.trim());
    }
  };

  // 1. 가격 구간별(Price Band) 국내 vs 글로벌 SKU 밀집도 데이터 산출
  const priceBandData = useMemo(() => {
    const bands = [
      { name: "1.5만원 미만", min: 0, max: 14999 },
      { name: "1.5만~2.5만", min: 15000, max: 24999 },
      { name: "2.5만~3.5만", min: 25000, max: 34999 },
      { name: "3.5만원 이상", min: 35000, max: Infinity }
    ];
    return bands.map((b) => ({
      name: b.name,
      국내몰: domesticProducts.filter((p) => p.price >= b.min && p.price <= b.max).length,
      글로벌몰: globalProducts.filter((p) => p.price >= b.min && p.price <= b.max).length
    }));
  }, [domesticProducts, globalProducts]);

  // 2. 방치되어 있던 historicalData를 활용한 현재 TOP 5 브랜드의 시계열 순위 변화(Bump Chart) 데이터
  const top5Products = useMemo(() => domesticProducts.slice(0, 5), [domesticProducts]);
  const rankTimelineData = useMemo(() => {
    if (!Array.isArray(historicalData) || historicalData.length === 0 || top5Products.length === 0) {
      return [];
    }
    return historicalData.map((snap) => {
      const d = new Date(snap.timestamp);
      const timeLabel = `${d.getMonth() + 1}/${d.getDate()} ${String(d.getHours()).padStart(2, "0")}시`;
      const row: Record<string, any> = { time: timeLabel };

      top5Products.forEach((targetProd) => {
        const key = `[${targetProd.brand}] ${targetProd.name.slice(0, 10)}`;
        const matched = snap.products?.find(
          (p) => p.id === targetProd.id || (p.brand === targetProd.brand && p.name === targetProd.name)
        );
        row[key] = matched ? matched.rank : 30;
      });
      return row;
    });
  }, [historicalData, top5Products]);

  const domAvgPrice = calcSafeTop10AvgPrice(domesticProducts);
  const globAvgPrice = calcSafeTop10AvgPrice(globalProducts);
  const priceGapPercent =
    domAvgPrice > 0 ? Math.round(((globAvgPrice - domAvgPrice) / domAvgPrice) * 100) : 0;

  return (
    <div className="space-y-5" id="charts-board-container">
      {/* 상단 컨트롤러 */}
      <div className="bg-white rounded-xl border border-gray-200 p-4 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div className="flex items-center gap-2">
          <BarChart3 className="w-5 h-5 text-[#98B941]" />
          <div>
            <h2 className="text-base font-extrabold text-gray-900">올리브영 랭킹 & 소비자 검색 수요 교차 분석</h2>
            <p className="text-xs text-gray-500">포털 검색량, 가격대별 SKU 밀집도, 상위권 순위 변동 추이를 다각도로 진단합니다.</p>
          </div>
        </div>

        <div className="flex flex-wrap items-center gap-2.5">
          <div className="flex items-center gap-1.5 bg-gray-50 border border-gray-200 px-3 py-2 rounded-lg">
            <span className="text-xs font-bold text-gray-500">카테고리:</span>
            <select
              value={selectedCategory}
              onChange={(e) => setSelectedCategory(e.target.value)}
              className="bg-transparent text-xs font-bold text-gray-900 focus:outline-none cursor-pointer"
            >
              {categories.map((c) => (
                <option key={c.id} value={c.id}>
                  {c.name}
                </option>
              ))}
            </select>
          </div>

          <form onSubmit={handleKeywordSubmit} className="flex items-center gap-1.5 bg-gray-50 border border-gray-200 pl-3 pr-1.5 py-1 rounded-lg">
            <Search className="w-3.5 h-3.5 text-gray-400 shrink-0" />
            <input
              type="text"
              value={inputKeyword}
