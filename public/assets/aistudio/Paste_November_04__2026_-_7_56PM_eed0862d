#### 적용 1: `src/components/RankingBoard.tsx` (국내·글로벌 소싱 갭 & 성분 키워드 점유율 배너 추가)

기존 `RankingBoard.tsx`의 상단 필터 바와 리스트 사이에 실측 데이터 기반의 'MD 소싱 기회 & 트렌드 키워드 요약 바'를 추가합니다. `RankingBoard.tsx` 내 `filteredGlobal` 선언 아래에 아래 분석 로직(`mdQuickInsights`)을 넣고 렌더링 영역에 배너를 추가하세요.

```tsx
// src/components/RankingBoard.tsx 내 filteredGlobal 선언(115행 부근) 바로 아래에 추가
  const mdQuickInsights = React.useMemo(() => {
    const domBrands = new Set(domesticProducts.map((p) => p.brand));
    const globBrands = new Set(globalProducts.map((p) => p.brand));

    // 국내 TOP 15 브랜드 중 글로벌 TOP 30에 아직 진입하지 못한 '글로벌 확장 유망 브랜드'
    const domOnlyTopBrands = Array.from(
      new Set(
        domesticProducts
          .slice(0, 15)
          .map((p) => p.brand)
          .filter((b) => !globBrands.has(b))
      )
    ).slice(0, 4);

    // 글로벌 TOP 15 브랜드 중 국내 TOP 30에 없는 '해외 전용/역직구 강세 브랜드'
    const globOnlyTopBrands = Array.from(
      new Set(
        globalProducts
          .slice(0, 15)
          .map((p) => p.brand)
          .filter((b) => !domBrands.has(b))
      )
    ).slice(0, 4);

    // 국내+글로벌 60개 상품명 내 주요 성분/효능 키워드 빈도 실측
    const allNames = [...domesticProducts, ...globalProducts].map((p) => p.name.toLowerCase());
    const keywordRules = [
      { label: "수분/히알루론", regex: /수분|히알루론|다이브인|독도|자작나무|hyaluronic|moisture|birch|dokdo/ },
      { label: "진정/시카/어성초", regex: /진정|시카|어성초|티트리|마데카|cica|heartleaf|teatree|calming|soothing/ },
      { label: "장벽/보습/세라마이드", regex: /장벽|아토|세라마이드|보습|크림|ceramide|atobarrier|barrier|cream/ },
      { label: "미백/비타/잡티", regex: /비타|청귤|잡티|미백|토닝|화이트|vita|tangerine|bright|spot/ },
      { label: "탄력/콜라겐/레티놀", regex: /콜라겐|레티놀|탄력|리프팅|단백질|손상|collagen|retinol|damage|repair/ }
    ];

    const keywordCounts = keywordRules
      .map((rule) => ({
        label: rule.label,
        count: allNames.filter((name) => rule.regex.test(name)).length
      }))
      .filter((k) => k.count > 0)
      .sort((a, b) => b.count - a.count);

    return { domOnlyTopBrands, globOnlyTopBrands, keywordCounts };
  }, [domesticProducts, globalProducts]);

```

