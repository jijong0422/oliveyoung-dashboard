                activeTab === "sheets" ? "bg-white text-gray-900 shadow-xs" : "text-gray-600 hover:text-gray-900"
              }`}
            >
              <FileSpreadsheet className="w-4 h-4 text-[#98B941]" />
              Google Sheets 연동
            </button>
            <button
              onClick={() => setActiveTab("monitoring")}
              className={`px-3.5 py-2 text-xs sm:text-sm font-bold rounded-lg transition-all cursor-pointer flex items-center gap-1.5 ${
                activeTab === "monitoring" ? "bg-white text-gray-900 shadow-xs" : "text-gray-600 hover:text-gray-900"
              }`}
            >
              <Database className="w-4 h-4 text-[#98B941]" />
              SLA 품질 모니터
              {unresolvedSlaErrors > 0 && (
                <span className="bg-red-500 text-white text-[11px] px-1.5 py-0.2 rounded-full font-extrabold">
                  {unresolvedSlaErrors}
                </span>
              )}
            </button>
          </div>

          {/* 사용자 인증 상태 카드 */}
          <div className="flex items-center gap-2 bg-white px-3 py-1.5 rounded-lg border border-gray-200 text-xs text-gray-700">
            {user ? (
              <div className="flex items-center gap-2 font-semibold">
                <div className="w-6 h-6 rounded-full bg-[#98B941] text-white flex items-center justify-center text-xs font-bold uppercase">
                  {user.email?.slice(0, 1) || "U"}
                </div>
                <span className="hidden sm:inline-block max-w-[150px] truncate">{user.email}</span>
                <button onClick={handleLogout} title="로그아웃" className="text-gray-400 hover:text-red-500 cursor-pointer">
                  <LogOut className="w-4 h-4" />
                </button>
              </div>
            ) : (
              <div className="flex items-center gap-2 font-semibold">
                <span className="w-2 h-2 rounded-full bg-amber-500" />
                <span className="text-gray-500">미연결</span>
                <button onClick={handleLogin} className="text-[#7a9630] hover:underline font-bold cursor-pointer">
                  Google 로그인
                </button>
              </div>
            )}
          </div>
        </section>

        {/* 4. Tab Stage Display */}
        <section className="min-h-[480px]">
          <AnimatePresence mode="wait">
            {activeTab === "rankings" && (
              <motion.div key="rankings" initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -8 }}>
                <RankingBoard
                  categories={categories}
                  historyRuns={historyRuns}
                  selectedCategory={selectedCategory}
                  setSelectedCategory={setSelectedCategory}
                  selectedTimestamp={selectedTimestamp}
                  setSelectedTimestamp={setSelectedTimestamp}
                  domesticProducts={domesticProducts}
                  globalProducts={globalProducts}
                  isLoading={isDataLoading}
                />
              </motion.div>
            )}

            {activeTab === "charts" && (
              <motion.div key="charts" initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -8 }}>
                <ChartsBoard
                  categories={categories}
                  selectedCategory={selectedCategory}
                  setSelectedCategory={setSelectedCategory}
                  domesticProducts={domesticProducts}
                  globalProducts={globalProducts}
                  historicalData={historicalData}
                />
              </motion.div>
            )}

            {activeTab === "ai" && (
              <motion.div key="ai" initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -8 }}>
                <AIAdvisor categories={categories} onGenerateInsight={handleGenerateInsight} />
              </motion.div>
            )}

            {activeTab === "sheets" && (
              <motion.div key="sheets" initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -8 }}>
                <SheetsExport
                  user={user}
                  needsAuth={needsAuth}
                  onLogin={handleLogin}
                  onLogout={handleLogout}
                  onExport={handleExportSheets}
                  recordsCount={totalProductsCount}
                />
              </motion.div>
            )}

            {activeTab === "reports" && (
              <motion.div key="reports" initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -8 }}>
                <ReportBuilder
                  categories={categories}
                  domesticProducts={domesticProducts}
                  globalProducts={globalProducts}
                  historyRuns={historyRuns}
                  selectedCategory={selectedCategory}
                  setSelectedCategory={setSelectedCategory}
                  selectedTimestamp={selectedTimestamp}
                  setSelectedTimestamp={setSelectedTimestamp}
                  isDataLoading={isDataLoading}
                  user={user}
                />
              </motion.div>
            )}

            {activeTab === "monitoring" && (
              <motion.div key="monitoring" initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -8 }}>
                <AlertTracker
                  mode="sla-only"
                  categories={categories}
                  alerts={alerts}
                  triggeredAlerts={triggeredAlerts}
                  onAddAlert={handleAddAlert}
                  onDeleteAlert={handleDeleteAlert}
                  onMarkAsRead={handleMarkAsRead}
                  onClearTriggered={handleClearTriggered}
                  monitoringLogs={monitoringLogs}
                  onClearMonitoringLogs={handleClearMonitoringLogs}
                  onTriggerTestLogs={handleTriggerTestLogs}
                  onResolveMonitoringLog={handleResolveMonitoringLog}
                  onResolveAllMonitoringLogs={handleResolveAllMonitoringLogs}
                />
              </motion.div>
            )}
          </AnimatePresence>
        </section>
      </main>

      {/* 5. 우측 슬라이드 알림 드로어 (기존 하단 고정 노출 제거) */}
      <AnimatePresence>
        {isAlertDrawerOpen && (
          <>
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setIsAlertDrawerOpen(false)}
              className="fixed inset-0 bg-black/30 backdrop-blur-xs z-50"
            />
            <motion.aside
              initial={{ x: "100%" }}
              animate={{ x: 0 }}
              exit={{ x: "100%" }}
              transition={{ type: "spring", damping: 28, stiffness: 300 }}
              className="fixed top-0 right-0 bottom-0 w-full max-w-md bg-[#F8FAFC] z-50 shadow-2xl border-l border-gray-200 flex flex-col"
            >
              <div className="p-4 bg-white border-b border-gray-200 flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <Bell className="w-5 h-5 text-[#98B941]" />
                  <h2 className="text-base font-extrabold text-gray-900">맞춤 트렌드 알림 센터</h2>
                </div>
                <button
                  onClick={() => setIsAlertDrawerOpen(false)}
                  className="p-1.5 rounded-lg text-gray-400 hover:text-gray-700 hover:bg-gray-100 cursor-pointer"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>
              <div className="flex-1 overflow-y-auto p-4">
                <AlertTracker
                  mode="alerts-only"
                  categories={categories}
                  alerts={alerts}
                  triggeredAlerts={triggeredAlerts}
                  onAddAlert={handleAddAlert}
                  onDeleteAlert={handleDeleteAlert}
                  onMarkAsRead={handleMarkAsRead}
                  onClearTriggered={handleClearTriggered}
                />
              </div>
            </motion.aside>
          </>
        )}
      </AnimatePresence>

      {/* 6. Footer Section */}
      <footer className="max-w-7xl mx-auto px-4 mt-12 py-6 border-t border-gray-200 text-center space-y-1 text-xs text-gray-500 font-medium">
        <p className="flex items-center justify-center gap-1.5">
          <ShieldCheck className="w-4 h-4 text-[#98B941]" />
          올리브영 글로벌·국내 랭킹 데이터 정합성 검증 파이프라인 적용
        </p>
        <p>© 2026 Olive Young Trend Intelligence. Powered by Google AI Studio & Gemini.</p>
      </footer>
    </div>
  );
}

