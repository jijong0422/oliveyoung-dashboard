### 2. `src/components/AlertTracker.tsx` (`mode` 분리 지원 및 타이포그래피 개선)

기존 `AlertTracker.tsx`에 `mode?: "alerts-only" | "sla-only" | "both"` 속성을 추가해 우측 드로어에서는 알림 규칙과 내역만 깔끔하게 보여주고, `SLA 품질 모니터` 탭에서는 데이터 검증 콘솔만 넓은 화면으로 보여주도록 개선했습니다. 또한 기존의 `text-[9px]`~`text-[10px]` 폰트를 모두 `text-xs`~`text-sm`으로 상향했습니다.

```tsx
/**
 * @license
 * SPDX-License-Identifier: Apache-2.0
 */
import React, { useState } from "react";
import {
  Bell,
  Play,
  Settings,
  Plus,
  Trash2,
  CheckCircle2,
  ShieldAlert,
  Database,
  Trash,
  ShieldCheck
} from "lucide-react";
import { CustomAlert, TriggeredAlert, Category, MonitoringLog } from "../types";

interface AlertTrackerProps {
  mode?: "alerts-only" | "sla-only" | "both";
  categories: Category[];
  alerts: CustomAlert[];
  triggeredAlerts: TriggeredAlert[];
  onAddAlert: (alert: Omit<CustomAlert, "id" | "createdAt">) => Promise<void>;
  onDeleteAlert: (id: string) => Promise<void>;
  onMarkAsRead: (id: string) => Promise<void>;
  onClearTriggered: () => Promise<void>;
  monitoringLogs?: MonitoringLog[];
  onClearMonitoringLogs?: () => Promise<void>;
  onTriggerTestLogs?: () => Promise<void>;
  onResolveMonitoringLog?: (id: string) => Promise<void>;
  onResolveAllMonitoringLogs?: () => Promise<void>;
}

export default function AlertTracker({
  mode = "both",
  categories,
  alerts,
  triggeredAlerts,
  onAddAlert,
  onDeleteAlert,
  onMarkAsRead,
  onClearTriggered,
  monitoringLogs = [],
  onClearMonitoringLogs,
  onTriggerTestLogs,
  onResolveMonitoringLog,
  onResolveAllMonitoringLogs
}: AlertTrackerProps) {
  const [name, setName] = useState("");
  const [categoryId, setCategoryId] = useState("all");
  const [conditionType, setConditionType] = useState<"first_place_change" | "brand_mention" | "rank_entry">("first_place_change");
  const [brandName, setBrandName] = useState("");
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [expandedLogId, setExpandedLogId] = useState<string | null>(null);
  const [isSimulatingLogs, setIsSimulatingLogs] = useState(false);

  const safeAlerts = Array.isArray(alerts) ? alerts : [];
  const safeTriggeredAlerts = Array.isArray(triggeredAlerts) ? triggeredAlerts : [];
  const unreadCount = safeTriggeredAlerts.filter((a) => !a.isRead).length;

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!name.trim()) return;
    setIsSubmitting(true);
    try {
      await onAddAlert({
        name,
        categoryId,
        conditionType,
        brandName: conditionType === "brand_mention" ? brandName : undefined,
        isActive: true
      });
      setName("");
      setBrandName("");
    } finally {
      setIsSubmitting(false);
    }
  };

  const showAlertsSection = mode === "alerts-only" || mode === "both";
  const showSlaSection = mode === "sla-only" || mode === "both";

  return (
    <div className="space-y-5" id="alert-tracker-container">
      {showAlertsSection && (
        <div className={mode === "alerts-only" ? "space-y-4" : "grid grid-cols-1 lg:grid-cols-3 gap-4"}>
          {/* 1. 발생 알림 내역 (가장 먼저 확인해야 하므로 드로어 상단 배치) */}
          <div className="bg-white rounded-xl border border-gray-200 p-4 shadow-xs flex flex-col">
            <div className="flex items-center justify-between mb-2">
              <h3 className="text-sm font-bold text-gray-900 flex items-center gap-1.5">
                <ShieldAlert className="w-4 h-4 text-amber-500" />
                실시간 감지 알림
                {unreadCount > 0 && (
                  <span className="bg-[#98B941] text-white text-xs px-2 py-0.5 rounded-full font-extrabold">
                    {unreadCount}
                  </span>
                )}
              </h3>
              {safeTriggeredAlerts.length > 0 && (
                <button
                  onClick={onClearTriggered}
                  className="text-xs text-gray-500 hover:text-gray-800 underline cursor-pointer font-semibold"
                >
                  전체 비우기
                </button>
              )}
            </div>

            <div className="space-y-2.5 max-h-[260px] overflow-y-auto pr-1 mt-2">
              {safeTriggeredAlerts.length === 0 ? (
                <div className="text-center py-8 text-xs text-gray-400 font-medium">
                  아직 발생한 트렌드 변동 알림이 없습니다.
                </div>
              ) : (
                safeTriggeredAlerts.map((log) => (
                  <div
                    key={log.id}
                    className={`p-3 rounded-lg border transition-all ${
                      log.isRead ? "bg-gray-50 border-gray-200 opacity-70" : "bg-[#98B941]/10 border-[#98B941]/30"
                    }`}
                  >
                    <div className="flex items-start justify-between gap-2">
                      <div className="space-y-1">
                        <p className={`text-xs leading-relaxed ${log.isRead ? "text-gray-600" : "text-gray-900 font-bold"}`}>
                          {log.message}
                        </p>
                        <div className="flex items-center gap-1.5 text-xs text-gray-500 font-medium">
                          <span>{log.alertName}</span>
                          <span>·</span>
                          <span>{new Date(log.timestamp).toLocaleTimeString("ko-KR")}</span>
                        </div>
                      </div>
                      {!log.isRead && (
                        <button
                          onClick={() => onMarkAsRead(log.id)}
                          className="text-[#7a9630] hover:text-[#607824] text-xs font-bold whitespace-nowrap cursor-pointer flex items-center gap-1 shrink-0"
                        >
                          <CheckCircle2 className="w-3.5 h-3.5" />
                          읽음
                        </button>
                      )}
                    </div>
                  </div>
                ))
              )}
            </div>
          </div>

          {/* 2. 새 알림 규칙 추가 */}
          <div className="bg-white rounded-xl border border-gray-200 p-4 shadow-xs">
            <h3 className="text-sm font-bold text-gray-900 mb-3 flex items-center gap-1.5">
              <Settings className="w-4 h-4 text-[#98B941]" />
              맞춤 알림 규칙 추가
            </h3>
            <form onSubmit={handleSubmit} className="space-y-3">
              <div>
                <label className="block text-xs font-bold text-gray-600 mb-1">규칙 이름</label>
                <input
                  type="text"
                  required
                  placeholder="예: 선케어 자사 브랜드 TOP 5 진입"
                  value={name}
                  onChange={(e) => setName(e.target.value)}
                  className="w-full text-xs border border-gray-300 rounded-lg p-2.5 focus:outline-none focus:ring-2 focus:ring-[#98B941]"
                />
              </div>

              <div className="grid grid-cols-2 gap-2.5">
                <div>
                  <label className="block text-xs font-bold text-gray-600 mb-1">감시 카테고리</label>
                  <select
                    value={categoryId}
                    onChange={(e) => setCategoryId(e.target.value)}
                    className="w-full text-xs border border-gray-300 rounded-lg p-2.5 bg-white focus:outline-none focus:ring-2 focus:ring-[#98B941]"
                  >
                    {categories.map((c) => (
                      <option key={c.id} value={c.id}>
                        {c.name}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-bold text-gray-600 mb-1">감지 조건</label>
                  <select
                    value={conditionType}
                    onChange={(e) => setConditionType(e.target.value as any)}
                    className="w-full text-xs border border-gray-300 rounded-lg p-2.5 bg-white focus:outline-none focus:ring-2 focus:ring-[#98B941]"
                  >
                    <option value="first_place_change">1위 상품 변동</option>
                    <option value="brand_mention">특정 브랜드 진입</option>
                    <option value="rank_entry">신규(NEW) 차트 진입</option>
                  </select>
                </div>
              </div>

              {conditionType === "brand_mention" && (
                <div>
                  <label className="block text-xs font-bold text-gray-600 mb-1">추적할 브랜드명</label>
                  <input
                    type="text"
                    required
                    placeholder="예: 토리든, 아누아"
                    value={brandName}
                    onChange={(e) => setBrandName(e.target.value)}
                    className="w-full text-xs border border-gray-300 rounded-lg p-2.5 focus:outline-none focus:ring-2 focus:ring-[#98B941]"
                  />
                </div>
              )}

              <button
                type="submit"
                disabled={isSubmitting}
                className="w-full bg-[#98B941] hover:bg-[#85a337] text-white text-xs font-bold py-2.5 rounded-lg transition-colors flex items-center justify-center gap-1.5 cursor-pointer disabled:bg-gray-300"
              >
                <Plus className="w-4 h-4" />
                {isSubmitting ? "등록 중..." : "알림 규칙 저장"}
              </button>
            </form>
          </div>

          {/* 3. 활성 규칙 목록 */}
          <div className="bg-white rounded-xl border border-gray-200 p-4 shadow-xs">
            <h3 className="text-sm font-bold text-gray-900 mb-3 flex items-center gap-1.5">
              <Bell className="w-4 h-4 text-[#98B941]" />
              활성 알림 규칙 ({safeAlerts.length})
            </h3>
            <div className="space-y-2 max-h-[220px] overflow-y-auto pr-1">
              {safeAlerts.length === 0 ? (
                <div className="text-center py-6 text-xs text-gray-400">등록된 알림 규칙이 없습니다.</div>
              ) : (
                safeAlerts.map((rule) => {
                  const catName = categories.find((c) => c.id === rule.categoryId)?.name || rule.categoryId;
                  return (
                    <div
                      key={rule.id}
                      className="p-3 bg-gray-50 rounded-lg border border-gray-200 flex items-center justify-between gap-3"
                    >
                      <div className="space-y-1">
                        <p className="text-xs font-bold text-gray-800">{rule.name}</p>
                        <div className="flex flex-wrap gap-1.5">
                          <span className="text-xs bg-gray-200 text-gray-700 px-2 py-0.5 rounded font-semibold">
                            {catName}
                          </span>
                          <span className="text-xs bg-[#98B941]/15 text-[#7a9630] px-2 py-0.5 rounded font-bold">
                            {rule.conditionType === "first_place_change"
                              ? "1위 변동"
                              : rule.conditionType === "brand_mention"
                              ? `브랜드 진입 (${rule.brandName})`
                              : "신규 진입"}
                          </span>
                        </div>
                      </div>
                      <button
                        onClick={() => onDeleteAlert(rule.id)}
                        className="text-gray-400 hover:text-red-500 p-1 rounded transition-colors cursor-pointer"
                        title="규칙 삭제"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    </div>
                  );
                })
              )}
            </div>
          </div>
        </div>
      )}

      {/* 4. SLA 스크래퍼 품질 및 데이터 규격 모니터링 콘솔 */}
      {showSlaSection && (
        <div className="bg-white rounded-xl border border-gray-200 p-5 shadow-xs" id="scraper-monitoring-console-card">
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 pb-4 mb-4">
            <div className="space-y-1">
              <h3 className="text-base font-extrabold text-gray-900 flex items-center gap-2">
                <Database className="w-5 h-5 text-[#98B941]" />
                스크래핑 데이터 품질 관리 (SLA) 콘솔
              </h3>
              <p className="text-xs text-gray-500">
                수집된 TOP 30 상품의 브랜드 매핑, 할인가 역전 여부, 누락 필드를 자동 검증합니다.
              </p>
            </div>

            <div className="flex flex-wrap items-center gap-2">
              {onTriggerTestLogs && (
                <button
                  type="button"
                  disabled={isSimulatingLogs}
                  onClick={async () => {
                    setIsSimulatingLogs(true);
                    try {
                      await onTriggerTestLogs();
                    } finally {
                      setIsSimulatingLogs(false);
                    }
                  }}
                  className="bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold px-3 py-2 rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer"
                >
                  <Play className="w-3.5 h-3.5 text-[#98B941] fill-current" />
                  검증 오류 테스트 생성
                </button>
              )}
              {onResolveAllMonitoringLogs && monitoringLogs.some((l) => l.status !== "resolved") && (
                <button
                  type="button"
                  onClick={onResolveAllMonitoringLogs}
                  className="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold px-3 py-2 rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer border border-emerald-200"
                >
                  <CheckCircle2 className="w-4 h-4 text-emerald-600" />
                  미해결 로그 일괄 해결
                </button>
              )}
              {onClearMonitoringLogs && monitoringLogs.length > 0 && (
                <button
                  type="button"
                  onClick={onClearMonitoringLogs}
                  className="bg-red-50 hover:bg-red-100 text-red-600 text-xs font-bold px-3 py-2 rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer"
                >
                  <Trash className="w-3.5 h-3.5" />
                  로그 초기화
                </button>
              )}
            </div>
          </div>

          {/* SLA 요약 배너 */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-3.5 mb-5">
            <div className="bg-emerald-50/60 border border-emerald-200 rounded-xl p-3.5 flex items-center gap-3">
              <div className="w-9 h-9 rounded-lg bg-emerald-600 text-white flex items-center justify-center">
                <ShieldCheck className="w-5 h-5" />
              </div>
              <div>
                <span className="text-xs font-semibold text-gray-500 block">파이프라인 상태</span>
                <span className="text-sm font-extrabold text-emerald-900">
                  {monitoringLogs.filter((l) => l.status !== "resolved" && l.level === "error").length > 0
                    ? "점검 필요 (오류 감지됨)"
                    : "정상 가동 중 (SLA 99.9%)"}
                </span>
              </div>
            </div>

            <div className="bg-amber-50/60 border border-amber-200 rounded-xl p-3.5 flex items-center gap-3">
              <div className="w-9 h-9 rounded-lg bg-amber-500 text-white flex items-center justify-center font-extrabold text-sm">
                !
              </div>
              <div>
                <span className="text-xs font-semibold text-gray-500 block">데이터 포맷·가격 경고</span>
                <span className="text-sm font-extrabold text-amber-900">
                  {
                    monitoringLogs.filter(
                      (l) => l.status !== "resolved" && (l.errorType === "format_mismatch" || l.errorType === "invalid_value")
                    ).length
                  }
                  건
                </span>
              </div>
            </div>

            <div className="bg-red-50/60 border border-red-200 rounded-xl p-3.5 flex items-center gap-3">
              <div className="w-9 h-9 rounded-lg bg-red-500 text-white flex items-center justify-center font-extrabold text-sm">
                X
              </div>
              <div>
                <span className="text-xs font-semibold text-gray-500 block">필수 데이터 누락</span>
                <span className="text-sm font-extrabold text-red-900">
                  {monitoringLogs.filter((l) => l.status !== "resolved" && l.errorType === "missing_data").length}건
                </span>
              </div>
            </div>
          </div>

          {/* 로그 리스트 */}
          <div className="border border-gray-200 rounded-xl overflow-hidden">
            <div className="divide-y divide-gray-200 max-h-[460px] overflow-y-auto">
              {monitoringLogs.length === 0 ? (
                <div className="text-center py-16 text-sm text-gray-500 font-semibold bg-white">
                  <ShieldCheck className="w-8 h-8 text-[#98B941] mx-auto mb-2" />
                  모든 상품 데이터가 규격 검증을 통과했습니다.
                </div>
              ) : (
                monitoringLogs.map((log) => {
                  const isExpanded = expandedLogId === log.id;
                  const isResolved = log.status === "resolved";
                  const categoryLabel = categories.find((c) => c.id === log.category)?.name || log.category;

                  return (
                    <div
                      key={log.id}
                      className={`p-4 transition-colors ${
                        isResolved ? "bg-gray-50 opacity-70 border-l-4 border-emerald-500" : "bg-white hover:bg-gray-50"
                      }`}
                    >
                      <div
                        onClick={() => setExpandedLogId(isExpanded ? null : log.id)}
                        className="flex items-start justify-between gap-3 cursor-pointer"
                      >
                        <div className="space-y-1.5 flex-1">
                          <div className="flex flex-wrap items-center gap-2">
                            <span
                              className={`text-xs px-2 py-0.5 rounded font-bold uppercase ${
                                isResolved
                                  ? "bg-emerald-600 text-white"
                                  : log.level === "error"
                                  ? "bg-red-500 text-white"
                                  : "bg-amber-500 text-white"
                              }`}
                            >
                              {isResolved ? "해결됨" : log.level}
                            </span>
                            <span className="text-xs bg-gray-100 text-gray-700 border border-gray-200 px-2 py-0.5 rounded font-semibold">
                              {categoryLabel} · {log.mallType === "domestic" ? "국내몰" : "글로벌몰"}
                            </span>
                            <span className="text-xs text-gray-400">
                              {new Date(log.timestamp).toLocaleTimeString("ko-KR")}
                            </span>
                          </div>
                          <p className={`text-sm font-bold ${isResolved ? "text-gray-500 line-through" : "text-gray-900"}`}>
                            {log.message}
                          </p>
                        </div>

                        {!isResolved && onResolveMonitoringLog && (
                          <button
                            type="button"
                            onClick={async (e) => {
                              e.stopPropagation();
                              await onResolveMonitoringLog(log.id);
                            }}
                            className="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1 cursor-pointer shrink-0"
                          >
                            <CheckCircle2 className="w-3.5 h-3.5" />
                            해결 처리
                          </button>
                        )}
                      </div>

                      {isExpanded && log.details && (
                        <div className="mt-3 p-3 bg-amber-50/70 border border-amber-200 rounded-lg text-xs text-gray-700">
                          <strong className="text-amber-900 block mb-0.5">상세 검증 내역:</strong>
                          {log.details}
                        </div>
                      )}
                    </div>
                  );
                })
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

```

